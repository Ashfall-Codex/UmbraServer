# Configuration de mare-server pour apple/container (les secrets sont ajoutés par dev-container.sh)
ASPNETCORE_ENVIRONMENT=Dev
Kestrel__Endpoints__Http__Url=http://+:6100
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information
Logging__LogLevel__MareSynchronosServer=Information
Logging__LogLevel__MareSynchronosShared=Information
Logging__LogLevel__MareSynchronosServer.Services.SystemInfoService=Warning
MareSynchronos__DbContextPoolSize=64
MareSynchronos__ShardName=Main
MareSynchronos__MetricsPort=6050
MareSynchronos__MainServerAddress=
MareSynchronos__FailedAuthForTempBan=20
MareSynchronos__TempBanDurationInMinutes=1
MareSynchronos__RedisConnectionString=umbra-redis.test:6379
MareSynchronos__RedisPool=5
MareSynchronos__MaxExistingGroupsByUser=6
MareSynchronos__MaxJoinedGroupsByUser=10
MareSynchronos__MaxGroupUserCount=100
MareSynchronos__AbsoluteMaxGroupUserCount=300
MareSynchronos__PurgeUnusedAccounts=false
MareSynchronos__ExpectedClientVersion=0.0.0.0
MareSynchronos__McdfStorageDirectory=/data/mcdf
