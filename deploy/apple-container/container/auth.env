# Configuration de mare-auth pour apple/container
ASPNETCORE_ENVIRONMENT=Dev
Kestrel__Endpoints__Http__Url=http://+:6101
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information
Logging__LogLevel__MareSynchronosAuthService=Information
Logging__LogLevel__MareSynchronosShared=Information
MareSynchronos__DbContextPoolSize=32
MareSynchronos__ShardName=AuthServices
MareSynchronos__MetricsPort=6150
MareSynchronos__RedisConnectionString=umbra-redis.test:6379
MareSynchronos__RedisPool=5
MareSynchronos__FailedAuthForTempBan=20
MareSynchronos__UseGeoIP=false
NearbyDiscovery__Store=redis
NearbyDiscovery__PresenceTtlMinutes=5
NearbyDiscovery__TokenTtlSeconds=120
NearbyDiscovery__MainBaseUrl=http://umbra-server.test:6100
