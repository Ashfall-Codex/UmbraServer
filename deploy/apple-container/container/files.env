# Configuration de mare-files pour apple/container
ASPNETCORE_ENVIRONMENT=Dev
Kestrel__Endpoints__Http__Url=http://+:6102
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information
Logging__LogLevel__MareSynchronosStaticFilesServer=Information
Logging__LogLevel__MareSynchronosShared=Information
MareSynchronos__DbContextPoolSize=32
MareSynchronos__ShardName=Files
MareSynchronos__MetricsPort=6250
MareSynchronos__ForcedDeletionOfFilesAfterHours=-1
MareSynchronos__CacheSizeHardLimitInGiB=10
MareSynchronos__UnusedFileRetentionPeriodInDays=14
MareSynchronos__CacheDirectory=/data/cache/
MareSynchronos__Bc7ConversionEnabled=true
MareSynchronos__Bc7ConversionEncodeConcurrency=2
MareSynchronos__RemoteCacheSourceUri=
MareSynchronos__MainServerAddress=http://umbra-server.test:6100
MareSynchronos__RedisConnectionString=umbra-redis.test:6379
MareSynchronos__RedisPool=5
MareSynchronos__MainFileServerAddress=
MareSynchronos__UseColdStorage=false
MareSynchronos__IsDistributionNode=true
MareSynchronos__ScalewayEnabled=true
MareSynchronos__ScalewayBucketName=umbrasync
MareSynchronos__ScalewayRegion=us-east-1
MareSynchronos__ScalewayEndpoint=http://umbra-s3.test:8333
